#!/bin/sh

SERVICE="t113-control"
MODE="${1:-test}"
SCOPE_SECONDS="${2:-30}"
CTRL_DEV="$(ls /dev/rpmsg_ctrl-* 2>/dev/null | head -n 1)"

if [ -z "$CTRL_DEV" ]; then
	echo "ERROR: no /dev/rpmsg_ctrl-* device"
	echo "Check: dmesg | grep -i -E 'c906|remoteproc|rpmsg|mailbox'"
	exit 1
fi

CTRL_NAME="${CTRL_DEV#/dev/rpmsg_ctrl-}"
# rpmsg_demo returns the allocated endpoint id as its process status, so a
# successful allocation is intentionally non-zero (normally 1 or 2).
CREATE_OUTPUT="$(rpmsg_demo -r "$CTRL_NAME" -c "$SERVICE")"
echo "$CREATE_OUTPUT"

EPT_ID="$(echo "$CREATE_OUTPUT" | sed -n 's|.*\/dev\/rpmsg\([0-9][0-9]*\).*|\1|p' | head -n 1)"
if [ -z "$EPT_ID" ]; then
	echo "ERROR: could not determine RPMsg endpoint id"
	exit 1
fi

EPT_DEV="/dev/rpmsg${EPT_ID}"
tries=0
while [ ! -e "$EPT_DEV" ] && [ "$tries" -lt 20 ]; do
	sleep 0.1
	tries=$((tries + 1))
done
if [ ! -e "$EPT_DEV" ]; then
	echo "ERROR: endpoint $EPT_DEV was not created"
	exit 1
fi

exec 3<>"$EPT_DEV"

cleanup()
{
	exec 3>&-
	rpmsg_demo -r "$CTRL_NAME" -d "$EPT_ID" >/dev/null 2>&1
}
trap cleanup EXIT INT TERM

exchange()
{
	command="$1"
	expected="$2"
	printf '%s' "$command" >&3
	reply="$(dd bs=256 count=1 <&3 2>/dev/null)" || {
		echo "FAIL: no reply for '$command'"
		exit 1
	}
	echo "$command -> $reply"
	case "$reply" in
		*$expected*) ;;
		*) echo "FAIL: expected reply containing '$expected'"; exit 1 ;;
	esac
}

echo "--- RPMsg bidirectional connectivity ---"
exchange PING "PONG c906"
exchange GET "STATUS enabled=0"

if [ "$MODE" = "scope" ]; then
	echo "--- Scope mode: CH1=25%, CH2=50%, CH3=75% at 5 kHz ---"
	exchange "SETALL 250 500 750" "target=250,500,750"
	exchange ENABLE "enabled=1"
	elapsed=0
	limit=$((SCOPE_SECONDS * 4))
	while [ "$elapsed" -lt "$limit" ]; do
		usleep 250000
		# GET also refreshes the 500 ms command watchdog.
		exchange GET "output=250,500,750"
		elapsed=$((elapsed + 1))
	done
	exchange STOP "enabled=0"
	usleep 10000
	exchange GET "output=0,0,0"
	echo "PASS: scope pattern completed and outputs returned safe"
	exit 0
fi

echo "--- Set all three hardware outputs to 25% and enable ---"
exchange "SET 250" "target=250"
exchange ENABLE "enabled=1"
usleep 10000
exchange GET "output=250,250,250"

echo "--- Wait 1 s; the 500 ms watchdog must force output to zero ---"
sleep 1
exchange GET "enabled=0 target=0,0,0 output=0,0,0"

echo "PASS: RPMsg request/reply and C906 watchdog verified"
